<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iOS 6 Dark Brushed Metal Transport Dock -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top chrome highlight line -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#585e6a" />
        </shape>
    </item>
    <!-- Dark metallic body -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2c2f36"
                android:centerColor="#1a1c20"
                android:endColor="#0f1013"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#0a0a0c" />
        </shape>
    </item>
</layer-list>
