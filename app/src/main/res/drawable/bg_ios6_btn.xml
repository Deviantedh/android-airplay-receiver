<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iOS 6 Circular Metallic Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="#101114"
                android:centerColor="#1a1c21"
                android:endColor="#292c33"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#2c2f37" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#454a55"
                android:centerColor="#262930"
                android:endColor="#181a1e"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#545a66" />
        </shape>
    </item>
</selector>
