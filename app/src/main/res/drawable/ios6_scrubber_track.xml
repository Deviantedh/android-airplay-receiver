<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iOS 6 Scrubber Track (Recessed groove + vibrant glossy blue fill) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track: Recessed dark rail -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient
                android:startColor="#101114"
                android:centerColor="#1a1c21"
                android:endColor="#282b33"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#0a0b0d" />
        </shape>
    </item>

    <!-- Progress: Classic iOS 6 Electric Blue glossy gradient -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:startColor="#479cf8"
                    android:centerColor="#1a76e8"
                    android:endColor="#084db8"
                    android:angle="270" />
                <stroke
                    android:width="1dp"
                    android:color="#6bb3ff" />
            </shape>
        </clip>
    </item>
</layer-list>
