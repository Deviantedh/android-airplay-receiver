<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iPod touch Glossy Dark Glass Header -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom dark drop line -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Main glossy glass body with top highlight -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f22c303a"
                android:centerColor="#e616181e"
                android:endColor="#fa0c0d10"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#484e5c" />
        </shape>
    </item>
</layer-list>
