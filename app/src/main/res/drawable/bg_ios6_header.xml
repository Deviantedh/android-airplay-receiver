<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iOS 6 Brushed Silver Navigation Header -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom dark drop shadow line -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3a3d43" />
        </shape>
    </item>
    <!-- Main brushed silver body with top highlight -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f2f4f6"
                android:centerColor="#c6ccd4"
                android:endColor="#a1a8b3"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#ffffff" />
        </shape>
    </item>
</layer-list>
