<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iPod touch Translucent Dark Glass Media Dock -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top hairline chrome highlight -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5a606e" />
        </shape>
    </item>
    <!-- Dark glass gradient body -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f0242832"
                android:centerColor="#f5121419"
                android:endColor="#fa08090b"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#1a1c22" />
        </shape>
    </item>
</layer-list>
