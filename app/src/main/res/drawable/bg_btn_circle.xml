<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent Glass Nav Button (CarPlay / Apple TV) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#47556f" />
            <stroke android:width="1dp" android:color="#647699" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#2b3648"
                android:endColor="#181e29"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#41516c" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
