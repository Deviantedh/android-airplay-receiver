<?xml version="1.0" encoding="utf-8"?>
<!-- Classic iOS 6 Silver Header Button / Status Pill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:startColor="#7a808a"
                android:centerColor="#9aa0ab"
                android:endColor="#c0c5cc"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#4b4f56" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:startColor="#ffffff"
                android:centerColor="#dbe0e6"
                android:endColor="#abb1bc"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#606670" />
        </shape>
    </item>
</selector>
