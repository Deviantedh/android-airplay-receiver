<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV / CarPlay Glossy White Play/Pause Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#d5d5db"
                android:endColor="#babac0"
                android:angle="270" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#ffffff"
                android:endColor="#e8e8ed"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#ffffff" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
