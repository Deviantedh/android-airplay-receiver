<?xml version="1.0" encoding="utf-8"?>
<!--
    Classic iPod touch / iOS "Now Playing" Landscape Interface
    Optimized for Samsung Galaxy Mini 2 (480x320 HVGA, Android 2.3.6)
    Dock Station Layout: Square Album Art on Left, Glossy Media Glass Dock on Right
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- Left: Full-Height Square Album Artwork -->
    <RelativeLayout
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/art_placeholder"
            android:contentDescription="@string/art_desc" />
    </RelativeLayout>

    <!-- Right: Classic iPod touch Translucent Dark Glass Control Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_ipod_dock_land"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Header: Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_ipod_glass_btn"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="○ Ожидание…"
                android:textColor="#d2d7e0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="-1"
                android:shadowRadius="0.5" />
        </LinearLayout>

        <!-- Metadata Section (Track Title, Artist, Album) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Track Title -->
            <TextView
                android:id="@+id/track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AirPlay"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true" />

            <!-- Artist -->
            <TextView
                android:id="@+id/track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Подключитесь через AirPlay"
                android:textColor="#b0b6c2"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true" />

            <!-- Album -->
            <TextView
                android:id="@+id/track_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:text="Receiver"
                android:textColor="#888e99"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Scrubber Slider with Left/Right Timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#b0b6c2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/ios6_scrubber_track"
                android:thumb="@drawable/ios6_scrubber_thumb"
                android:thumbOffset="8dp"
                android:maxHeight="5dp"
                android:minHeight="5dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />

            <TextView
                android:id="@+id/time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-:--"
                android:textColor="#b0b6c2"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Transport Controls (|<<, ▶/❚❚, >>|) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ipod_transport_btn"
                android:src="@android:drawable/ic_media_previous"
                android:scaleType="centerInside"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/bg_ipod_transport_btn"
                android:src="@android:drawable/ic_media_play"
                android:scaleType="centerInside"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ipod_transport_btn"
                android:src="@android:drawable/ic_media_next"
                android:scaleType="centerInside"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Next" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
