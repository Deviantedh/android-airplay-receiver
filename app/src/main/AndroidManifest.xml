<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.splendid.airplay"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- ───────────────── Permissions ───────────────── -->
    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep CPU alive while streaming -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground Service needs RECEIVE_BOOT_COMPLETED for auto-restart (optional) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- We only target phones with WiFi -->
    <uses-feature android:name="android.hardware.wifi"           android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen"    android:required="false" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="false">

        <!-- Main UI Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensor"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service – hosts the native AirPlay daemon -->
        <service
            android:name=".service.AirPlayService"
            android:exported="false" />

        <!-- Optional: restart receiver on boot -->
        <receiver android:name=".service.BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Minimum API 10 == Android 2.3.3 -->
    <uses-sdk
        android:minSdkVersion="10"
        android:targetSdkVersion="10" />

</manifest>
